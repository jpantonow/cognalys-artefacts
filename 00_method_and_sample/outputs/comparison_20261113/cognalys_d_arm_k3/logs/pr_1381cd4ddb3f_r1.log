nge_required': False, 'client_only_change_safe': False, 'rollout_strategy': '', 'pull_request_note': ''}, 'review_assumptions': ['For an AndroidKeyStore AES key, getKey and getEntry(...).secretKey return the same key, so behavior is unchanged.', 'The safe cast (as? SecretKey) is used so a non-secret-key alias entry falls back to initAndroidSecretKey as the previous as? KeyStore.SecretKeyEntry cast did.', 'No tests are added because the code needs the Android keystore and the plan lists no required tests.'], 'review_blockers': [], 'required_tests': [], 'decision': 'MULTI_FILE_FIX_PROPOSED_FOR_REVIEW', 'manual_review_required': True, 'auto_apply': False, 'publication_allowed': False, 'publication_status': 'blocked', 'semantic_validation': {'status': 'valid', 'errors': [], 'warnings': []}, 'stored_value_contract': {'version': 1, 'status': 'partial', 'entries': [], 'required_paths': [], 'limitations': ['persistence sink identity could not be resolved', 'no preference entry resolved from the observed persistence sinks'], 'unresolved_sinks': [{'path': 'app/src/main/java/de/jepfa/yapm/ui/createvault/CreateVaultEnterPinFragment.kt', 'line': 73, 'operation': 'putString', 'storage_expression': 'args', 'key_expression': 'ARG_ENC_PIN', 'storage': '', 'key': '', 'value_expression': 'encPin.toBase64String()', 'statement': 'args.putString(ARG_ENC_PIN, encPin.toBase64String())', 'derivation': ''}], 'unresolved_readers': [], 'unmodelled_sinks': [], 'source_hashes': {}, 'bound': 'Lexical preference accessors with unique declarations; unresolved identities and index limits are explicit. Other persistence sinks are listed with the statements naming the same constant or literal, unmodelled.'}, 'fix_scope': 'review_only', 'applied_for_validation': True, 'review_contract_version': 23, 'pr_attribution': {}, 'status': 'NOT_APPLICABLE_TO_BASE', 'error': 'ORIGINAL_CODE_ABSENT_FROM_BASE_BRANCH', 'original_method_body': '        androidKeyStore.load(null)\n        val entry: KeyStore.Entry? = androidKeyStore.getEntry(androidKey.alias, null)\n\n        val sk = (entry as? KeyStore.SecretKeyEntry)?.secretKey ?: initAndroidSecretKey(androidKey, context)\n', 'corrected_method_body': '        androidKeyStore.load(null)\n        val existingKey = androidKeyStore.getKey(androidKey.alias, null) as? SecretKey\n\n        val sk = existingKey ?: initAndroidSecretKey(androidKey, context)\n', 'finding_id': '1381cd4ddb3f', 'branch': 'fix/getandroidsecretkey-keystorespec-1381cd4ddb3f-64bafae97c', 'base_branch': 'master', 'base_commit': '670ff023cd3cee4c8f0efc6b0ce10223fc0d784a', 'solution_revision': '64bafae97c', 'worktree_attempt': 1, 'orphaned_worktree_paths': [], 'worktree_path': '/home/antonow/cognalys_work/d_arm_sonnet_k3/pr_1381cd4ddb3f_r1/worktrees/de.jepfa.yapm.debug_202006.apk/1381cd4ddb3f/64bafae97c', 'base_repository_path': '/home/antonow/cognalys_work/d_arm_sonnet_k3/pr_1381cd4ddb3f_r1/clones/de.jepfa.yapm.debug_202006.apk', 'base_port': {'decision': 'ABSTAIN', 'explanation': "The base's SecretService.getAndroidSecretKey no longer has the reported violation. Upstream already replaced the getEntry lookup with `androidKeyStore.getKey(androidKey.alias, null) as? SecretKey ?: initAndroidSecretKey(androidKey, context)`. The call sequence is now load, then getKey, which is what the reviewed patch produces, and the initAndroidSecretKey fallback is kept. No edit is needed.", 'error': 'PORT_ALREADY_FIXED_UNCONFIRMED', 'attempts': [], 'model_decision': 'ALREADY_FIXED_UPSTREAM'}, 'coordinated_edits': [], 'changed_files': [], 'contribution_base': {'base_branch': 'master', 'base_commit': '670ff023cd3cee4c8f0efc6b0ce10223fc0d784a', 'source_file_path': 'app/src/main/java/de/jepfa/yapm/service/secret/SecretService.kt', 'target_present': True, 'analyzed_code_present': False}}], 'errors': []}

