    {
      "url": "https://api.github.com/repos/SapuSeven/BetterUntis/issues/comments/5252553606",
      "html_url": "https://github.com/SapuSeven/BetterUntis/pull/515#issuecomment-5252553606",
      "issue_url": "https://api.github.com/repos/SapuSeven/BetterUntis/issues/515",
