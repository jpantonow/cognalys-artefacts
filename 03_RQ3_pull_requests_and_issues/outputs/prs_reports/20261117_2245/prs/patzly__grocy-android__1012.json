      "following_url": "https://api.github.com/users/jpantonow/following{/other_user}",
      "gists_url": "https://api.github.com/users/jpantonow/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/jpantonow/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/jpantonow/subscriptions",
      "organizations_url": "https://api.github.com/users/jpantonow/orgs",
      "repos_url": "https://api.github.com/users/jpantonow/repos",
