    "locked": false,
    "title": "Require AES keys before initializing encryption",
    "user": {
      "login": "jpantonow",
      "id": 129221613,
      "node_id": "U_kgDOB7PD7Q",
      "avatar_url": "https://avatars.githubusercontent.com/u/129221613?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/jpantonow",
