gException, InvalidKeySpecException, IOException {\n        SecretKeyFactory skf = getSecretKeyFactory();\n        SecretKey pwd = skf.generateSecret(spec);\n\n        byte[] raw = new byte[pwd.getEncoded().length];\n        try {\n            new SecureRandom().nextBytes(raw);\n            SecretKey key = new SecretKeySpec(raw, "AES");\n            mEncryptedKey = EncryptedKey.encrypt(createAuthenticatedMasterKey(pwd, key));\n        } finally {\n            java.util.Arrays.fill(raw, (byte) 0);\n        }\n        mIterations = spec.getIterationCount();\n        mAlgorithm = skf.getAlgorithm();\n        mSalt = spec.getSalt();\n    }\n\n    private static SecretKey createAuthenticatedMasterKey(SecretKey passwordKey,\n            SecretKey masterKey) {\n        byte[] passwordBytes = passwordKey.getEncoded();\n        byte[] masterBytes = masterKey.getEncoded();\n        byte[] authenticatedMaster = new byte[passwordBytes.length + masterBytes.length];\n        try {\n            System.arraycopy(passwordBytes, 0, authenticatedMaster, 0, passwordBytes.length);\n            System.arraycopy(masterBytes, 0, authenticatedMaster, passwordBytes.length,\n                    masterBytes.length);\n            return new SecretKeySpec(authenticatedMaster, "AES");\n        } finally {\n            java.util.Arrays.fill(passwordBytes, (byte) 0);\n            java.util.Arrays.fill(masterBytes, (byte) 0);\n            java.util.Arrays.fill(authenticatedMaster, (byte) 0);\n        }\n    }', 'reason': "New MasterKey values retain an independently generated AES master key, but encrypt an authenticated composite through EncryptedKey's generated-key overload. The PBKDF2 result is data authenticated by the generated key rather than the key supplied to encryption Cipher.init; temporary raw and composite buffers are wiped after SecretKeySpec construction."}, {'source_file': 'mobile/src/main/java/org/fedorahosted/freeotp/encryptor/MasterKey.java', 'symbol': 'decrypt(PBEKeySpec)', 'edit_kind': 'method', 'original_code': '    private SecretKey decrypt(PBEKeySpec spec) throws NoSuchAlgorithmException,\n            InvalidKeySpecException, IllegalBlockSizeException, InvalidKeyException,\n            BadPaddingException, InvalidAlgorithmParameterException, NoSuchPaddingException,\n            IOException {\n        SecretKeyFactory skf = SecretKeyFactory.getInstance(mAlgorithm);\n        SecretKey pwd = skf.generateSecret(spec);\n        return mEncryptedKey.decrypt(pwd);\n    }', 'corrected_code': '    private SecretKey decrypt(PBEKeySpec spec) throws NoSuchAlgorithmException,\n            InvalidKeySpecException, IllegalBlockSizeException, InvalidKeyException,\n            BadPaddingException, InvalidAlgorithmParameterException, NoSuchPaddingException,\n            IOException {\n        SecretKeyFactory skf = SecretKeyFactory.getInstance(mAlgorithm);\n        SecretKey pwd = skf.generateSecret(spec);\n\n        if (mEncryptedKey.usesGeneratedKey()) {\n            return extractAuthenticatedMasterKey(mEncryptedKey.decrypt(pwd), pwd);\n        }\n\n        SecretKey masterKey = mEncryptedKey.decrypt(pwd);\n        mEncryptedKey = EncryptedKey.encrypt(createAuthenticatedMasterKey(pwd, masterKey));\n        return masterKey;\n    }\n\n    private static SecretKey extractAuthenticatedMasterKey(SecretKey authenticatedMasterKey,\n            SecretKey passwordKey) throws BadPaddingException {\n        byte[] authenticatedMaster = authenticatedMasterKey.getEncoded();\n        byte[] passwordBytes = passwordKey.getEncoded();\n        try {\n            if (authenticatedMaster.length != passwordBytes.length + BYTES) {\n                throw new BadPaddingException("Incorrect password or corrupted master key");\n            }\n\n            int difference = 0;\n            for (int i = 0; i < passwordBytes.length; i++) {\n                difference |= authenticatedMaster[i] ^ passwordBytes[i];\n            }\n            if (difference != 0) {\n                throw new BadPaddingException("Incorrect password or corrupted master key");\n            }\n\n            byte[] masterBytes = new byte[BYTES];\n            try {\n                System.arraycopy(authenticatedMaster, passwordBytes.length, masterBytes, 0,\n                        masterBytes.length);\n                return new SecretKeySpec(masterBytes, "AES");\n            } finally {\n                java.util.Arrays.fill(masterBytes, (byte) 0);\n            }\n        } finally {\n            java.util.Arrays.fill(authenticatedMaster, (byte) 0);\n            java.util.Arrays.fill(passwordBytes, (byte) 0);\n        }\n    }', 'reason': 'Current representations decrypt through their referenced generated key, then compare the stored PBKDF2 authentication bytes with the attempted password derivation before returning the original random AES master key. Legacy representations retain their PBKDF2-key decrypt path and are rewritten only after that decrypt succeeds, so incorrect passwords neither return a key nor trigger migration.'}, {'source_file': 'mobile/src/androidTest/java/org/fedorahosted/freeotp/encryptor/EncryptedKeyTest.java', 'symbol': 'EncryptedKey current/legacy compatibility and MasterKey password-authentication test cases', 'edit_kind': 'create', 'original_code': '', 'corrected_code': 'package org.fedorahosted.freeotp.encryptor;\n\nimport org.junit.Assert;\nimport org.junit.Test;\n\nimport java.security.NoSuchAlgorithmException;\n\nimport javax.crypto.BadPaddingException;\nimport javax.crypto.KeyGenerator;\nimport javax.crypto.SecretKey;\n\npublic class EncryptedKeyTest {\n    @Test\n    public void testCurrentFormatRoundTrip() throws Exception {\n        SecretKey plaintext = generateAesKey();\n\n        EncryptedKey encrypted = EncryptedKey.encrypt(plaintext);\n        SecretKey decrypted = encrypted.decrypt(null);\n\n        Assert.assertArrayEquals(plaintext.getEncoded(), decrypted.getEncoded());\n    }\n\n    @Test\n    public void testLegacyFormatRoundTripWithCallerSuppliedKey() throws Exception {\n        SecretKey legacyKey = generateAesKey();\n        SecretKey plaintext = generateAesKey();\n\n        EncryptedKey encrypted = EncryptedKey.encrypt(legacyKey, plaintext);\n        SecretKey decrypted = encrypted.decrypt(legacyKey);\n\n        Assert.assertArrayEquals(plaintext.getEncoded(), decrypted.getEncoded());\n    }\n\n    @Test\n    public void testMasterKeyRejectsWrongPasswordWithoutInvalidatingRepresentation() throws Exception {\n        MasterKey masterKey = MasterKey.generate("correct password");\n\n        try {\n            masterKey.decrypt("wrong password");\n            Assert.fail("Decrypting with an incorrect password must fail");\n        } catch (BadPaddingException expected) {\n            // The authentication failure is the expected concrete failure mode.\n        }\n\n        SecretKey firstDecrypt = masterKey.decrypt("correct password");\n\n        try {\n            masterKey.decrypt("wrong password");\n            Assert.fail("Decrypting with an incorrect password must continue to fail");\n        } catch (BadPaddingException expected) {\n            // The failed attempt must not rewrite or invalidate the representation.\n        }\n\n        SecretKey secondDecrypt = masterKey.decrypt("correct password");\n        Assert.assertArrayEquals(firstDecrypt.getEncoded(), secondDecrypt.getEncoded());\n    }\n\n    private SecretKey generateAesKey() throws NoSuchAlgorithmException {\n        KeyGenerator generator = KeyGenerator.getInstance("AES");\n        generator.init(128);\n        return generator.generateKey();\n    }\n}\n', 'reason': 'Adds dedicated encryptor-package instrumentation coverage for both supported EncryptedKey formats and password authentication using only confirmed public APIs. Each test declares Exception so all JCA checked exceptions remain compilable, while wrong-password assertions verify the concrete BadPaddingException contract.'}], 'changed_files': ['mobile/src/main/java/org/fedorahosted/freeotp/encryptor/EncryptedKey.java', 'mobile/src/main/java/org/fedorahosted/freeotp/encryptor/Encryptor.java', 'mobile/src/main/java/org/fedorahosted/freeotp/encryptor/MasterKey.java', 'mobile/src/androidTest/java/org/fedorahosted/freeotp/encryptor/EncryptedKeyTest.java'], 'quality_score': 100, 'explanation': '<!-- pr-title: Use generated AndroidKeyStore keys for current encryption -->\nI found that `EncryptedKey.encrypt` initialized encryption with caller-provided AndroidKeyStore or PBKDF2 keys. CipherSpec’s usage rule does not recognize those key origins as generated encryption keys, so the `Cipher.init` call did not meet the rule.\n\nI now create a fresh AES/GCM AndroidKeyStore key for current-format encryption and store its alias with the encrypted value. Token and master-key encryption use that path; legacy values retain their existing decrypt path and migrate only after password authentication succeeds. I added instrumentation coverage for current and legacy round trips and wrong-password handling, while leaving GCM initialization, parameters, and AAD order unchanged.', 'applied_timestamp': '2026-10-28T02:21:11.635718+00:00'}], 'errors': []}

