her.ENCRYPT_MODE, key);\n        return new EncryptedKey(cipher, plaintext, null);\n    }\n\n    boolean usesGeneratedKey() {\n        return mKeyReference != null;\n    }\n\n    public SecretKey decrypt(SecretKey key)\n            throws NoSuchPaddingException, NoSuchAlgorithmException, BadPaddingException,\n            IllegalBlockSizeException, IOException, InvalidAlgorithmParameterException,\n            InvalidKeyException {\n        SecretKey decryptionKey = usesGeneratedKey() ? getKey(mKeyReference) : key;\n        Cipher cipher = Cipher.getInstance(mCipher);\n        cipher.init(Cipher.ENCRYPT_MODE, decryptionKey);\n        String algorithm = cipher.getParameters().getAlgorithm();\n\n        AlgorithmParameters ap = AlgorithmParameters.getInstance(algorithm);\n        ap.init(mParameters);\n\n        cipher.init(Cipher.DECRYPT_MODE, decryptionKey, ap);\n        cipher.updateAAD(mToken.getBytes(StandardCharsets.UTF_8));\n        return new SecretKeySpec(cipher.doFinal(mCipherText), mToken);\n    }\n\n    private static SecretKey generateKey(String keyReference) throws NoSuchAlgorithmException {\n        try {\n            KeyGenerator generator = KeyGenerator.getInstance(\n                    KeyProperties.KEY_ALGORITHM_AES, KEYSTORE_PROVIDER);\n            generator.init(new KeyGenParameterSpec.Builder(\n                    keyReference,\n                    KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)\n                    .setBlockModes(KeyProperties.BLOCK_MODE_GCM)\n                    .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)\n                    .build());\n            return generator.generateKey();\n        } catch (NoSuchProviderException | InvalidAlgorithmParameterException e) {\n            throw new NoSuchAlgorithmException("Unable to generate AndroidKeyStore AES key", e);\n        }\n    }\n\n    private static SecretKey getKey(String keyReference)\n            throws NoSuchAlgorithmException, InvalidKeyException, IOException {\n        try {\n            KeyStore keyStore = KeyStore.getInstance(KEYSTORE_PROVIDER);\n            keyStore.load(null);\n            Key key = keyStore.getKey(keyReference, null);\n            if (!(key instanceof SecretKey)) {\n                throw new InvalidKeyException("AndroidKeyStore key is unavailable: " + keyReference);\n            }\n            return (SecretKey) key;\n        } catch (KeyStoreException | UnrecoverableKeyException | CertificateException e) {\n            throw new InvalidKeyException("Unable to retrieve AndroidKeyStore key: " + keyReference, e);\n        }\n    }\n}\n', 'finding_id': '4b81532bb668', 'branch': 'fix/encrypt-cipherspec-4b81532bb668-53bd075253', 'base_branch': 'master', 'base_commit': '7f7f68351a80c9ea175256f339ee6f7428b3d128', 'solution_revision': '53bd075253', 'worktree_attempt': 1, 'orphaned_worktree_paths': [], 'worktree_path': '/home/antonow/cognalys_work/exp_final_v6/finding_worktrees/org.fedorahosted.freeotp_48.apk/4b81532bb668/53bd075253', 'base_repository_path': '/home/antonow/cognalys_work/exp_final_v6/clones/org.fedorahosted.freeotp_48.apk', 'coordinated_edits': [{'source_file': 'mobile/src/main/java/org/fedorahosted/freeotp/encryptor/EncryptedKey.java', 'symbol': 'EncryptedKey.encrypt, EncryptedKey.decrypt, and the representation construction/parsing paths', 'edit_kind': 'declaration', 'original_code': 'package org.fedorahosted.freeotp.encryptor;\n\nimport android.util.Log;\n\nimport java.io.IOException;\nimport java.nio.charset.StandardCharsets;\nimport java.security.AlgorithmParameters;\nimport java.security.InvalidAlgorithmParameterException;\nimport java.security.InvalidKeyException;\nimport java.security.NoSuchAlgorithmException;\n\nimport javax.crypto.BadPaddingException;\nimport javax.crypto.Cipher;\nimport javax.crypto.IllegalBlockSizeException;\nimport javax.crypto.NoSuchPaddingException;\nimport javax.crypto.SecretKey;\nimport javax.crypto.spec.SecretKeySpec;\n\npublic final class 