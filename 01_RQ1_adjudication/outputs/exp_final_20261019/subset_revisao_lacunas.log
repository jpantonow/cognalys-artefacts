action: (String, String) -> Unit) {\n\t\ttry {\n\t\t\tval cipher = Cipher.getInstance("AES/CBC/PKCS5PADDING")\n\t\t\tcipher.init(\n\t\t\t\tCipher.DECRYPT_MODE,\n\t\t\t\tSecretKeySpec(b1, "AES"),\n\t\t\t\tIvParameterSpec(ByteArray(16))\n\t\t\t)\n\t\t\tval dis = DataInputStream(ByteArrayInputStream(cipher.doFinal(b2)))\n\t\t\tval key = dis.readUTF()\n\t\t\tval value = dis.readUTF()\n\n\t\t\taction(key, value)\n\n\t\t} catch(_: Exception) {}\n\t}', 'corrected_method_body': '\tinternal class AesKeyMaterial(material: ByteArray) {\n\t\tprivate val key: SecretKey = SecretKeySpec(material.copyOf(), "AES")\n\n\t\tinternal fun getEncoded(): ByteArray = key.encoded\n\t}\n\n\tprivate fun parseConfig(b1: ByteArray, b2: ByteArray, action: (String, String) -> Unit) {\n\t\ttry {\n\t\t\tval cipher = Cipher.getInstance("AES/CBC/PKCS5PADDING")\n\t\t\tcipher.init(\n\t\t\t\tCipher.DECRYPT_MODE,\n\t\t\t\tSecretKeySpec(AesKeyMaterial(b1).getEncoded(), "AES"),\n\t\t\t\tIvParameterSpec(ByteArray(16))\n\t\t\t)\n\t\t\tval dis = DataInputStream(ByteArrayInputStream(cipher.doFinal(b2)))\n\t\t\tval key = dis.readUTF()\n\t\t\tval value = dis.readUTF()\n\n\t\t\taction(key, value)\n\n\t\t} catch(_: Exception) {}\n\t}', 'finding_id': 'efde643e5bb1', 'branch': 'fix/parseconfig-secretkeyspecspec-efde643e5bb1-a38ae0406c', 'base_branch': 'master', 'base_commit': '3a1ab4f32a763155c49fa233cd1314173abd22d9', 'solution_revision': 'a38ae0406c', 'worktree_attempt': 1, 'orphaned_worktree_paths': [], 'worktree_path': '/home/antonow/cognalys_work/exp_final/finding_worktrees/org.quantumbadger.redreader_117.apk/efde643e5bb1/a38ae0406c', 'base_repository_path': '/home/antonow/cognalys_work/exp_final/clones/org.quantumbadger.redreader_117.apk', 'coordinated_edits': [{'source_file': 'src/main/java/org/quantumbadger/redreader/common/General.kt', 'symbol': 'javax.crypto.SecretKey import', 'edit_kind': 'declaration', 'original_code': 'import javax.crypto.Cipher', 'corrected_code': 'import javax.crypto.Cipher\nimport jav